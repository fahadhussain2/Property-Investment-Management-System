# Production builds only (deploy.yml passes these from the GitHub "production" environment secrets).
# Local development needs no .env: `npm run dev` reads them from `supabase status`.
# Find both in the Supabase dashboard: Project Settings → API (Project URL, anon/public key).
# The anon key is public by design (RLS protects the data). NEVER put the service_role key here.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon-public-key>
